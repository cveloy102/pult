<Window x:Class="Pult.Agent.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Пульт · агент Windows" Icon="Assets/pult.ico" Width="660" Height="800" MinWidth="520" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{DynamicResource Base}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource Mono}" FontSize="13">
  <Grid Margin="28,22,28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel>
        <TextBlock Text="[ ЛОКАЛЬНОЕ УПРАВЛЕНИЕ / WINDOWS ]" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,0,0,8"/>
        <TextBlock FontFamily="{DynamicResource Display}" FontSize="36"><Run Text="Пульт"/><Run Text="_" Foreground="{DynamicResource Accent}"/></TextBlock>
      </StackPanel>
      <TextBlock x:Name="RunningLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource Online}" FontSize="12" Margin="0,0,0,8"/>
    </Grid>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,18">
      <Button x:Name="OverviewTab" Style="{StaticResource Tab}" Content="Обзор" Click="OverviewClick" Margin="0,0,4,0"/>
      <Button x:Name="PhonesTab" Style="{StaticResource Tab}" Content="Телефоны" Click="PhonesClick" Margin="2,0,2,0"/>
      <Button x:Name="NetworkTab" Style="{StaticResource Tab}" Click="NetworkClick" Margin="2,0,2,0"><TextBlock><Run Text="Сеть"/><Run x:Name="NetworkBadge" Text="" Foreground="{DynamicResource Accent}"/></TextBlock></Button>
      <Button x:Name="SettingsTab" Style="{StaticResource Tab}" Content="Настройки" Click="SettingsClick" Margin="4,0,0,0"/>
    </UniformGrid>
    <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PultScrollBar}"/></ScrollViewer.Resources>
      <StackPanel x:Name="Page" Margin="0,0,12,0"/>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
      <StackPanel>
        <TextBlock x:Name="Notice" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
        <Grid>
          <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource Sub}" FontSize="11" VerticalAlignment="Center"/>
          <Button Content="Обновления ↗" HorizontalAlignment="Right" Click="UpdateClick" MinHeight="38" Padding="14,6" FontSize="12"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
